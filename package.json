{
  "name": "@mapeo/sqlite-indexer",
  "version": "1.0.2",
  "description": "Index Mapeo data in a SQLite database",
  "main": "index.js",
  "types": "types/index.d.ts",
  "type": "module",
  "scripts": {
    "test": "run-p lint type borp",
    "lint": "eslint .",
    "borp": "c8 --100 borp",
    "posttest": "c8 report --reporter=text-lcov > ./coverage/lcov.info",
    "type": "tsc",
    "prepare": "husky",
    "prepack": "npm run type"
  },
  "keywords": [],
  "author": "Digital Democracy",
  "license": "MIT",
  "engines": {
    "node": ">=18.17.1",
    "npm": ">=9.6.7"
  },
  "peerDependencies": {
    "better-sqlite3": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/tmp": "^0.2.6",
    "better-sqlite3": "^13.0.1",
    "borp": "^1.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.6",
    "tmp": "^0.2.7",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "lint-staged": {
    "*.js": [
      "eslint --cache --fix"
    ],
    "*.{js,css,md}": "prettier --write"
  },
  "files": [
    "types"
  ],
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digidem/mapeo-sqlite-indexer.git"
  },
  "bugs": {
    "url": "https://github.com/digidem/mapeo-sqlite-indexer/issues"
  },
  "homepage": "https://github.com/digidem/mapeo-sqlite-indexer#readme"
}
